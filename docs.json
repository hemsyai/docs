{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Hemsy | API Documentation",
  "colors": {
    "primary": "#090909",
    "light": "#6B6B6B",
    "dark": "#090909"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "products": [
      {
        "product": "For Merchants",
        "tabs": [
          {
            "tab": "Embeds",
            "groups": [
              {
                "group": "Embeds",
                "pages": [
                  "embeds/overview",
                  "embeds/launch-modes",
                  "embeds/checkout-vs-cart",
                  "embeds/javascript-api"
                ]
              }
            ]
          },
          {
            "tab": "Deep Links",
            "pages": ["deep-links"]
          },
          {
            "tab": "Integrations",
            "groups": [
              {
                "group": "Integrations",
                "pages": ["segment"]
              }
            ]
          },
          {
            "tab": "Permissions",
            "pages": ["permissions"]
          },
          {
            "tab": "API Reference",
            "pages": ["api-reference/merchant-try-on"]
          }
        ]
      },
      {
        "product": "For Developers",
        "tabs": [
          {
            "tab": "Agents",
            "groups": [
              {
                "group": "Agents",
                "pages": [
                  "agents/overview",
                  "agents/authentication",
                  "agents/mcp",
                  "agents/rest-api"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "pages": ["api-reference/agent-try-on"]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/embeds",
      "destination": "/embeds/overview"
    },
    {
      "source": "/api-reference/try-on",
      "destination": "/api-reference/merchant-try-on"
    }
  ],
  "api": {
    "playground": {
      "mode": "show"
    },
    "examples": {
      "languages": ["curl", "python", "javascript", "node"]
    }
  },
  "logo": {
    "light": "/logo/dark.svg",
    "dark": "/logo/light.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@hemsy.ai"
      },
      {
        "label": "API keys",
        "href": "https://developers.hemsy.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.hemsy.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/tryhemsy"
    }
  },
  "appearance": {
    "default": "light",
    "strict": true
  }
}
