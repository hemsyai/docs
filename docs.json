{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Hemsy | API Documentation",
  "colors": {
    "primary": "#090909",
    "light": "#6B6B6B",
    "dark": "#090909"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "groups": [
      {
        "group": "Guides",
        "pages": ["embeds", "deep-links", "segment"]
      },
      {
        "group": "Dashboard",
        "pages": ["permissions"]
      },
      {
        "group": "API Reference",
        "openapi": "api-reference/openapi.json",
        "pages": ["POST /api/try-on"]
      }
    ]
  },
  "api": {
    "playground": {
      "mode": "show"
    },
    "examples": {
      "languages": ["curl", "python", "javascript", "node"]
    }
  },
  "logo": {
    "light": "/logo/dark.svg",
    "dark": "/logo/light.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@hemsy.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.hemsy.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/tryhemsy"
    }
  },
  "modeToggle": {
    "default": "light",
    "isHidden": true
  }
}
