{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Hemsy | API Documentation",
  "colors": {
    "primary": "#090909",
    "light": "#6B6B6B",
    "dark": "#090909"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "groups": [
      {
        "group": "Merchants",
        "pages": [
          {
            "group": "Embeds",
            "pages": [
              "embeds/overview",
              "embeds/launch-modes",
              "embeds/checkout-vs-cart",
              "embeds/javascript-api"
            ]
          },
          "deep-links",
          {
            "group": "Integrations",
            "pages": ["segment"]
          },
          "permissions"
        ]
      },
      {
        "group": "Agents",
        "pages": [
          "agents/overview",
          "agents/authentication",
          "agents/mcp",
          "agents/rest-api"
        ]
      },
      {
        "group": "API Reference",
        "pages": ["api-reference/merchant-try-on", "api-reference/agent-try-on"]
      }
    ]
  },
  "redirects": [
    {
      "source": "/embeds",
      "destination": "/embeds/overview"
    },
    {
      "source": "/api-reference/try-on",
      "destination": "/api-reference/merchant-try-on"
    }
  ],
  "api": {
    "playground": {
      "mode": "show"
    },
    "examples": {
      "languages": ["curl", "python", "javascript", "node"]
    }
  },
  "logo": {
    "light": "/logo/dark.svg",
    "dark": "/logo/light.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@hemsy.ai"
      },
      {
        "label": "Developers",
        "href": "https://developers.hemsy.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.hemsy.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/tryhemsy"
    }
  },
  "appearance": {
    "default": "light",
    "strict": true
  }
}
